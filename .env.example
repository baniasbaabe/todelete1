# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-token

# Supported AI providers
GROQ_API_KEY=your-groq-api-key
JINA_API_KEY=your-jina-api-key
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small

# Database Configuration
# Matches the PostgreSQL service in docker-compose.yaml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/habit_tracker

# LLM Configuration
LLM_MODEL=qwen/qwen3.6-27b
LLM_TEMPERATURE=0.2

# Mem0 configuration
# Mem0 uses the Groq model above and LangChain + Jina embeddings.
MEM0_EMBEDDING_DIMS=1024
MEM0_COLLECTION_NAME=mem0_jina
MEM0_TELEMETRY=false

# Observability (Optional)
COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_API_KEY=
ENABLE_TRACING=false

# Leave empty for local polling. These are required only for webhook deployments.
WEBHOOK_URL=
WEBHOOK_SECRET=
